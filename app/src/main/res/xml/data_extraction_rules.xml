        <include domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="omniagent_api_key_prefs.xml"/>
        <exclude domain="sharedpref" path="lia_google_workspace_auth_prefs.xml"/>
        <exclude domain="sharedpref" path="lia_security_vault_prefs.xml"/>
